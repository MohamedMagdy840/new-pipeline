pipeline {
    agent any

    stages {
        stage('Hello World') {
            steps {
                echo 'Hello World'
            }
        }
        stage('Hello Jenkins') {
            steps {
                echo 'Hello Jenkins'
            }
        }
        
        stage('Hello World2') {
            steps {
                echo 'Hello World2'
                echo 'Hello World'
            }
        }
        stage('Hello Jenkins2') {
            steps {
                echo 'Hello Jenkins'
            }
        }

    }
}
